# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# generated media (hosted on Supabase Storage)
/public/images/*
!/public/images/backgrounds/
!/public/images/shop/
!/public/images/dashboard/
!/public/images/avatars/
!/public/images/auth-bg.png
!/public/images/auth-bg.webp
!/public/images/jennifer.jpg
!/public/images/email/
!/public/images/jennifer-portrait.jpg
!/public/images/ui/
!/public/images/ui/grades/
!/public/images/story-styles/
!/public/images/story-types/
/public/audio/
/scripts/image-progress.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# Playwright
/test-results/
/playwright-report/
/playwright/.cache/


# Demo recorder auth cache
.demo-auth.json
.demo-rec-*/
scripts/demo-out/
lesson-shots/

# Content-factory runtime artifacts (logs + queue/error state, not source)
scripts/*.log
scripts/factory-queue.json
scripts/factory-quiz-error.json
scratch_dl/

# Instagram ad recorder output
scripts/ad-out/
